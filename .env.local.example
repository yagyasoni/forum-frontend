# Copy to .env.local for local development. Production values live in Vercel.

# Where forum-backend runs.
#   live:  https://api.auditprorx.com/forum
#   local: http://localhost:5001
NEXT_PUBLIC_API_BASE_URL=https://api.auditprorx.com/forum

# true = answer every API call from lib/mock.ts (no backend needed). false = use the live API above.
NEXT_PUBLIC_USE_MOCK=false

# Main AuditProRx API. The payer lookup uses its existing /api/bin-search.
NEXT_PUBLIC_AUDIT_API_BASE_URL=https://api.auditprorx.com
